GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional per-feature overrides. They fall back to GROQ_MODEL when omitted.
GROQ_ANIMATED_MODEL=openai/gpt-oss-20b
GROQ_MINIGAME_MODEL=openai/gpt-oss-20b
GROQ_SIMULATION_MODEL=openai/gpt-oss-20b
# Optional Vite build-time override when not using the local Vite proxy
VITE_API_URL=/api
